# Example environment variables for AKAZA backend
# Copy this file to .env and edit the values for your environment.

# Database connection
DATABASE_URL=postgresql://postgres:admin1234@localhost:5432/akaza_db

# Allowed origins for CORS (frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend base URL used by scripts/tests
API_URL=http://127.0.0.1:8000

# API keys and secrets
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=your_jwt_secret
TELEGRAM_API_KEY=your_telegram_api_key
ID_ADMIN=your_admin_id
